      "persistentCacheTargetMiB": 100,
      "concurrentFetchesInitial": 2
    },
    "medium": {
      "targetFps": 45,
      "dynamicResolution": [
        0.85,
        1
      ],
      "msaaSamples": 1,
      "shadows": false,
      "postprocess": false,
      "ambientLight": true,
