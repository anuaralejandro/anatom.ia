      "cpuDecodedBudgetMiB": 96,
      "persistentCacheTargetMiB": 300,
      "concurrentFetchesInitial": 3
    },
    "high": {
      "targetFps": 60,
      "dynamicResolution": [
        1,
        1
      ],
      "msaaSamples": 4,
      "shadows": "deferred_optional",
      "postprocess": false,
      "ambientLight": true,
      "geometryStrategy": "highest appropriate LOD",
